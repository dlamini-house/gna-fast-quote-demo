# Copy these into Vercel > Project > Settings > Environment Variables
# (do NOT commit a real .env file to GitHub).

# Safe for the browser. Starts with pk_test_ (testing) or pk_live_ (live).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SECRET. Server only (used by api/paystack-verify.js). Starts with sk_test_ / sk_live_.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
